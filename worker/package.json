{
  "name": "sof-logging",
  "version": "1.0.0",
  "description": "Sound of Fractions logging API (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply sof-logs --local",
